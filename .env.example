# ─────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to .env.local for development; set the same
# names in Vercel -> Project -> Settings -> Environment Variables for deploys.
#
# There is ONE runtime now. Convex had its own sandbox with its own env (set
# via `npx convex env set`), which is why email silently no-op'd when a key was
# only in Vercel. Everything below is read by Next.js; there is nowhere else
# to set anything.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API (or Connect -> App Frameworks).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (sb_publishable_...), or the legacy anon JWT. Safe to
# ship to browsers: it carries no authority of its own, RLS decides everything.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The SECRET key (sb_secret_...), or the legacy service_role JWT. BYPASSES RLS.
#   - NEVER prefix with NEXT_PUBLIC_ -- that would publish it to every visitor
#   - Vercel: set it for Production and Preview only, marked Sensitive
# Used server-side by exactly two routes:
#   /api/leads           the only way a lead enters the database (rate limits
#                        + owner email). WITHOUT IT, INQUIRY FORMS RETURN 503.
#   /api/account/delete  removes the auth identity after the data is erased
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Drives metadataBase / OG images, the
# dashboard link in lead emails, and the default support@<domain> address.
# Must match the Site URL configured in Supabase Auth (see SETUP.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Support inbox shown in customer-facing copy. Defaults to
# support@<host of NEXT_PUBLIC_APP_URL>.
SUPPORT_EMAIL=

# ── Email (Resend) ────────────────────────────────────────────────────────
# Lead-notification emails to profile owners. Without the key, leads are still
# saved and still raise an in-app notification; only the email is skipped.
# https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Until a sending domain is verified in Resend, the default
# onboarding@resend.dev sender ONLY delivers to the Resend account owner.
# Once a domain is verified: RESEND_FROM_EMAIL="Connecta <hello@yourdomain.com>"
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# NOT AN APP VARIABLE -- the Supabase MCP token.
#
# .mcp.json is committed and this repository is public. The token lives only
# in .mcp.env (gitignored) and is loaded by the launcher script, never here,
# never in .mcp.json, and never as a machine-wide environment variable.
# ─────────────────────────────────────────────────────────────────────────
