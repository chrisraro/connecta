# Clerk Authentication Configuration
# Find these in your Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Next.js Application URL
# Use http://localhost:3000 for local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex Database Integration
# These are automatically set up when you run `npx convex dev`
# DO NOT edit them manually if npx convex dev handles them, but you can define them here.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Resend (transactional email)
# Used by convex/email.ts to send lead notifications and order confirmations.
# Without this, those emails are skipped (logged as a warning) instead of sent.
# Get a key at https://resend.com/api-keys. NOTE: until a sending domain is
# verified in Resend, mail only delivers to the account owner (sandbox mode).
RESEND_API_KEY=

# PayRex (Philippine payment gateway)
# Used by convex/billing.ts and convex/payrex.ts for plan checkout.
PAYREX_SECRET_KEY=
# Used by convex/http.ts to verify PayRex webhook signatures (HMAC-SHA256).
PAYREX_WEBHOOK_SECRET=
