# ─────────────────────────────────────────────────────────────────────────
# NEXT.JS / VERCEL runtime — set these in `.env.local` for dev, and in the
# Vercel project's Environment Variables for deploys. Convex functions run in
# a completely separate runtime and CANNOT read these (see the CONVEX
# RUNTIME section below) — a var only listed here does nothing for
# convex/*.ts code.
# ─────────────────────────────────────────────────────────────────────────

# Clerk Authentication Configuration
# Find these in your Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Next.js Application URL
# Use http://localhost:3000 for local development
# Also used to derive lib/brand.ts's CONNECTA.domain (OG image footer,
# metadataBase) and the default support@<domain> address — see SUPPORT_EMAIL
# below if you want the support inbox to differ from the app's own domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support inbox shown in customer-facing emails (convex/email.ts) and OG
# output. Optional — without it, CONNECTA.supportEmail falls back to
# support@<NEXT_PUBLIC_APP_URL's host>. Set this explicitly if support email
# is handled on a different domain than the app itself, or before
# NEXT_PUBLIC_APP_URL points at a domain that isn't registered yet.
# NOTE: convex/email.ts reads this from the CONVEX runtime, not this file —
# see the CONVEX RUNTIME section below. It's listed here too only because
# NEXT_PUBLIC_APP_URL (which lib/brand.ts also derives from) is a Next.js var;
# set the same value in both places with the commands noted below.
SUPPORT_EMAIL=

# Convex Database Integration
# These are automatically set up when you run `npx convex dev`
# DO NOT edit them manually if npx convex dev handles them, but you can define them here.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ─────────────────────────────────────────────────────────────────────────
# CONVEX RUNTIME — these are read inside convex/*.ts actions/mutations
# (a separate sandboxed runtime from Next.js/Vercel). Setting them in Vercel
# or `.env.local` does NOTHING for this code — they must be pushed with:
#   npx convex env set <NAME> <VALUE>          (dev deployment)
#   npx convex env set <NAME> <VALUE> --prod   (production deployment)
# Putting only these in Vercel silently makes email a no-op.
# ─────────────────────────────────────────────────────────────────────────

# Resend (transactional email)
# Used by convex/email.ts to send lead notifications and order confirmations.
# Without this, those emails are skipped (logged as a warning) instead of sent.
# Get a key at https://resend.com/api-keys. NOTE: until a sending domain is
# verified in Resend, mail only delivers to the account owner (sandbox mode).
RESEND_API_KEY=

# Clerk webhook signing secret (Svix)
# Used by convex/http.ts to verify the /clerk-webhook signature before acting
# on a `user.deleted` event. Copy it from the endpoint you create in Clerk
# Dashboard -> Webhooks; it starts with "whsec_". The route FAILS CLOSED
# without it (500, body never read), so an unset value is never treated as an
# open endpoint — but account deletions made outside the app then orphan
# their Convex rows.
CLERK_WEBHOOK_SIGNING_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# NOT AN APP VARIABLE — SUPABASE_ACCESS_TOKEN
#
# .mcp.json (committed, and this repository is public) references
# ${SUPABASE_ACCESS_TOKEN} so the token itself never lands in the repo. It is
# read from the machine's environment, not from any file here:
#   Windows:  setx SUPABASE_ACCESS_TOKEN "sbp_..."     (then reopen the shell)
#   macOS/Linux: export it from your shell profile
# Never put it in .env.local, .env.example, or .mcp.json. A Supabase personal
# access token is account-wide: it reaches every project in every org you
# belong to, not just this one.
# ─────────────────────────────────────────────────────────────────────────
