# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything is ignored by default, so a real secret can only
# reach the repo by being force-added. .env.example is the one deliberate
# exception (placeholders only) and is negated explicitly rather than relying
# on it already being tracked.
.env*
!.env.example

# credential material that must never be committed
*.pem
*.p12
*.pfx
*.key
!**/public/**/*.key
id_rsa
id_ed25519
.supabase/
.convex/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Inert scratch artifacts from sandboxed editing
*.tmp
*.new
*.build
SENTINEL_TEST.txt

# firecrawl scrape cache
.firecrawl/

# local convex data snapshots (never commit customer data)
.backups/
